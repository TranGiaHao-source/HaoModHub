--================ LOADING SCREEN GOLD =================
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local PlayerGui = player:WaitForChild("PlayerGui")

local ScriptURL = "https://raw.githubusercontent.com/TranGiaHao-source/HaoModHub/refs/heads/main/HAOMODHUB_VIP_.txt"

-- bảng màu GOLD
local GOLD_MAIN = Color3.fromRGB(255,195,40)
local GOLD_LIGHT = Color3.fromRGB(255,215,90)
local GOLD_TEXT = Color3.fromRGB(255,230,150)
local DARK_BG = Color3.fromRGB(35,28,15)

local gui = Instance.new("ScreenGui", PlayerGui)
gui.Name = "HaoLoader"
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0,340,0,160)
frame.Position = UDim2.new(0.5,-170,0.5,-80)
frame.BackgroundColor3 = DARK_BG
frame.BackgroundTransparency = 1
Instance.new("UICorner",frame).CornerRadius = UDim.new(0,14)

local stroke = Instance.new("UIStroke",frame)
stroke.Color = GOLD_MAIN
stroke.Thickness = 2
stroke.Transparency = 1

-- TITLE
local title = Instance.new("TextLabel",frame)
title.Size = UDim2.new(1,0,0.4,0)
title.BackgroundTransparency = 1
title.Text = "HAO MOD HUB"
title.Font = Enum.Font.GothamBold
title.TextScaled = true
title.TextColor3 = GOLD_MAIN
title.TextTransparency = 1

-- glow
local glow = Instance.new("UIStroke",title)
glow.Color = GOLD_MAIN
glow.Thickness = 1.5
glow.Transparency = 0.4

-- percent
local percent = Instance.new("TextLabel",frame)
percent.Position = UDim2.new(0,0,0.4,0)
percent.Size = UDim2.new(1,0,0.2,0)
percent.BackgroundTransparency = 1
percent.Text = "0%"
percent.Font = Enum.Font.GothamBold
percent.TextScaled = true
percent.TextColor3 = GOLD_LIGHT
percent.TextTransparency = 1

-- status
local status = Instance.new("TextLabel",frame)
status.Position = UDim2.new(0,0,0.6,0)
status.Size = UDim2.new(1,0,0.2,0)
status.BackgroundTransparency = 1
status.Text = "Injecting..."
status.Font = Enum.Font.Gotham
status.TextScaled = true
status.TextColor3 = GOLD_TEXT
status.TextTransparency = 1

-- LOADING BAR BG
local barBG = Instance.new("Frame",frame)
barBG.Size = UDim2.new(0.85,0,0,10)
barBG.Position = UDim2.new(0.075,0,0.82,0)
barBG.BackgroundColor3 = Color3.fromRGB(20,16,10)
barBG.BackgroundTransparency = 0.3
Instance.new("UICorner",barBG).CornerRadius = UDim.new(1,0)

-- LOADING BAR
local bar = Instance.new("Frame",barBG)
bar.Size = UDim2.new(0,0,1,0)
bar.BackgroundColor3 = GOLD_MAIN
Instance.new("UICorner",bar).CornerRadius = UDim.new(1,0)

-- fade in
TweenService:Create(frame,TweenInfo.new(0.4),{BackgroundTransparency=0.15}):Play()
TweenService:Create(stroke,TweenInfo.new(0.4),{Transparency=0}):Play()
TweenService:Create(title,TweenInfo.new(0.4),{TextTransparency=0}):Play()
TweenService:Create(percent,TweenInfo.new(0.4),{TextTransparency=0}):Play()
TweenService:Create(status,TweenInfo.new(0.4),{TextTransparency=0}):Play()

task.wait(0.4)

-- loading animation
for i=1,100 do
    percent.Text = i.."%"
    bar:TweenSize(UDim2.new(i/100,0,1,0),Enum.EasingDirection.Out,Enum.EasingStyle.Quad,0.01,true)
    task.wait(0.01)
end

status.Text = "Injected Successfully"
percent.Text = "100%"

task.wait(0.7)

-- fade out
TweenService:Create(frame,TweenInfo.new(0.35),{BackgroundTransparency=1}):Play()
TweenService:Create(stroke,TweenInfo.new(0.35),{Transparency=1}):Play()
TweenService:Create(title,TweenInfo.new(0.35),{TextTransparency=1}):Play()
TweenService:Create(percent,TweenInfo.new(0.35),{TextTransparency=1}):Play()
TweenService:Create(status,TweenInfo.new(0.35),{TextTransparency=1}):Play()

task.wait(0.4)
gui:Destroy()

-- load script
loadstring(game:HttpGet(ScriptURL))()
